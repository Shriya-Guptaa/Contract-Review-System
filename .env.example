# Copy this file to .env and fill in only the values below. Do NOT commit .env.

# GROQ API key
GROQ_API_KEY= your-groq-api-key-here

# Path to vector store directory (default relative path)
VECTOR_STORE_PATH=./data/vector_store

# Chunking parameters
CHUNK_SIZE=prefferably 1000
CHUNK_OVERLAP=prefferably 200

# Minimum score threshold for compliance checks
MIN_COMPLIANCE_SCORE=0.7

# Ngrok auth token
NGROK_AUTH=your-ngrok-auth-token-here
